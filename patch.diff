+def _copy_json(value, memo=None):
+    """ copy.deepcopy for JSON documents, falling back for other objects """
+    if value is None:
+        return value
+    t = type(value)
+    if t is str or t is int or t is bool or t is float:
+        return value
+    if memo is None:
+        memo = {}
+    vid = id(value)
+    copied = memo.get(vid)
+    if copied is not None:
+        return copied
+    if t is dict:
+        copied = {}
+        memo[vid] = copied
+        for key, item in value.items():
+            kt = type(key)
+            if not (kt is str or kt is int or kt is bool or kt is float):
+                key = _copy_json(key, memo)
+            copied[key] = _copy_json(item, memo)
+        return copied
+    if t is list:
+        copied = []
+        memo[vid] = copied
+        for item in value:
+            copied.append(_copy_json(item, memo))
+        return copied
+    if t is tuple:
+        copied = tuple(_copy_json(item, memo) for item in value)
+        memo[vid] = copied
+        return copied
+    return copy.deepcopy(value, memo)
+
